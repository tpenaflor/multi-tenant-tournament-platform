// Prisma Schema for Multi-Tenant Bracket Sports Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  customDomain String?     @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  isActive    Boolean      @default(true)
  theme       String?      // Stores JSON string of theme configuration (e.g. primaryColor, backgroundColor)

  members     OrganizationMember[]
  players     Player[]
  tournaments Tournament[]
  pages       Page[]
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  name                  String?
  isPlatformAdmin       Boolean               @default(false)
  createdAt             DateTime              @default(now())
  
  organizationMembers   OrganizationMember[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("PLAYER") // ORGANIZER, PLAYER
  isBanned       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
}

model TournamentMember {
  id             String       @id @default(uuid())
  playerId       String
  player         Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournamentId   String
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  role           String       @default("PLAYER") // PLAYER, TEMPORARY_ORGANIZER
  isBanned       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([playerId, tournamentId])
}

model Tournament {
  id             String       @id @default(uuid())
  name           String
  slug           String
  sport          String       @default("Pickleball") // Pickleball, Tennis, Badminton
  format         String       @default("SingleElimination") // SingleElimination, DoubleElimination, RoundRobin
  status         String       @default("DRAFT") // DRAFT, PUBLISHED, IN_PROGRESS, COMPLETED
  startDate      DateTime?
  endDate        DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brackets       Bracket[]
  members        TournamentMember[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
}

model Bracket {
  id           String     @id @default(uuid())
  name         String
  division     String?    // e.g. Men's Doubles 4.0, Open Singles
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  data         String     // Stores JSON string of matches, rounds, seedings from brackets-manager
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Page {
  id             String       @id @default(uuid())
  title          String
  slug           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  components     String       // Layout JSON string: [{ type: "HeroBanner", props: {...} }]
  published      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
}

// NextAuth.js Models for Tenant Players

model Player {
  id            String    @id @default(uuid())
  name          String?
  email         String?
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // For traditional email/password login
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  accounts      Account[]
  sessions      Session[]
  tournamentMembers TournamentMember[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([email, organizationId])
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user Player @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         Player   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

